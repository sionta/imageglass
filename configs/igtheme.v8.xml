<ImageGlass>
  <Theme>
    <Info
        name="{{NAME}}"
        version="1.2"
        author="Felkon"
        email=""
        website="https://github.com/FelkonEXE"
        description="Dracula - Dark theme for ImageGlass"
        type="ImageGlass Theme Configuration"
        configversion="8.0"
        preview="preview.jpg"
    />
    <main
        backcolor="#282A36"
        topbarcolor="#282A36"
        bottombarcolor="#2B2E3B"
        statuscolor="#F8F8F2"
        menubackgroundcolor="#282A36"
        menubackgroundhovercolor="#44475A"
        menutextcolor="#F8F8F2"
        menutexthovercolor="#FF79C6"
        accentcolor="#BD93F9"
        accentlightcolor="#FF79C6"
        accentdarkcolor="#44475A"
        logo="Dracula.svg"
        isshowtitlebarlogo="true"
        isdarkmode="True"
    />
    <toolbar_icon
        back="ViewPreviousImage.svg"
        next="ViewNextImage.svg"
        gofirst="ViewFirstImage.svg"
        golast="ViewLastImage.svg"
        leftrotate="RotateLeft.svg"
        rightrotate="RotateRight.svg"
        fliphorz="FlipHorz.svg"
        flipvert="FlipVert.svg"
        crop="Crop.svg"
        colorpicker="ColorPicker.svg"
        zoomin="ZoomIn.svg"
        zoomout="ZoomOut.svg"
        autozoom="AutoZoom.svg"
        zoomlock="LockZoom.svg"
        scaletowidth="ScaleToWidth.svg"
        scaletoheight="ScaleToHeight.svg"
        zoomtofit="ScaleToFit.svg"
        scaletofill="ScaleToFill.svg"
        scaletofit="ActualSize.svg"
        open="OpenFile.svg"
        refresh="Refresh.svg"
        gotoimage="GoToImage.svg"
        autosizewindow="WindowFit.svg"
        fullscreen="FullScreen.svg"
        slideshow="Slideshow.svg"
        checkerboard="Checkerboard.svg"
        thumbnail="Gallery.svg"
        delete="Delete.svg"
        print="Print.svg"
        edit="Edit.svg"
        convert="Save.svg"
        menu="MainMenu.svg"
    />
  </Theme>
</ImageGlass>